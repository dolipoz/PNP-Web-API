FROM php:8.4-apache

# Instalar MySQLi para conectar con la base de datos
RUN docker-php-ext-install mysqli pdo pdo_mysql

# Habilitar módulos apache necesarios
RUN a2enmod rewrite

# Pasar página completa
COPY HTML /var/www/html
RUN chown -R www-data:www-data /var/www/html && chown -R 755 /var/www/html/*

# Copiar configuración personalizada tras cambiar las variables por valores
COPY Docker/apache/http-var.conf /etc/apache2/sites-available/http.conf

# Habilitar sitio SSL
RUN a2ensite http.conf

# Exponer puertos
EXPOSE 80
